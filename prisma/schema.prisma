// Study OS database schema.
//
// Portable between SQLite (default, zero-setup local mode) and PostgreSQL:
// no provider-specific types are used. To switch to PostgreSQL, change
// `provider` below to "postgresql", set DATABASE_URL, delete prisma/migrations
// and run `npx prisma migrate dev --name init` (see DATABASE.md).
//
// Conventions
// - Every row belongs to a User (single local user today; multi-user ready).
// - IDs are generated by the client (UUID) so rows can be created offline.
// - Soft deletion via `deletedAt`; nothing is hard-deleted by normal use.
// - Enumerated values are stored as strings and validated with Zod
//   (src/lib/schemas/entities.ts), which keeps the schema portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String   @default("")
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings         Settings?
  subjects         Subject[]
  units            CurriculumUnit[]
  chapters         Chapter[]
  lessons          Lesson[]
  studySessions    StudySession[]
  scheduleBlocks   ScheduleBlock[]
  backlogItems     BacklogItem[]
  tasks            Task[]
  revisions        Revision[]
  mistakes         Mistake[]
  questionSets     QuestionSet[]
  exams            Exam[]
  goals            Goal[]
  calendarEvents   CalendarEvent[]
  pomodoroSessions PomodoroSession[]
  thoughts         Thought[]
  sleepEntries     SleepEntry[]
  dailyReviews     DailyReview[]
  weeklyReviews    WeeklyReview[]
  roadmapPhases    RoadmapPhase[]
}

/// One JSON settings document per user, validated by settingsSchema.
model Settings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id                String    @id
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo            Boolean   @default(false)
  name              String
  icon              String
  color             String
  priority          Int
  weeklyTargetHours Float
  weeklySessions    Int
  difficulty        Int
  importance        Int
  enabled           Boolean
  archived          Boolean
  order             Int
  examDate          String?
  notes             String
  manualProgress    Float?
  currentChapterId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  units          CurriculumUnit[]
  chapters       Chapter[]
  lessons        Lesson[]
  studySessions  StudySession[]
  scheduleBlocks ScheduleBlock[]
  backlogItems   BacklogItem[]
  tasks          Task[]
  revisions      Revision[]
  mistakes       Mistake[]
  questionSets   QuestionSet[]
  exams          Exam[]
  goals          Goal[]

  @@index([userId])
}

model CurriculumUnit {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo    Boolean   @default(false)
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  notes     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  chapters Chapter[]

  @@index([userId, subjectId])
}

model Chapter {
  id        String         @id
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo    Boolean        @default(false)
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitId    String
  unit      CurriculumUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  notes     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  lessons Lesson[]

  @@index([userId, unitId])
}

/// Topics (the lowest curriculum level) are stored as a JSON checklist.
model Lesson {
  id                 String    @id
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo             Boolean   @default(false)
  subjectId          String
  subject            Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId          String
  chapter            Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title              String
  description        String
  estimatedMinutes   Int
  status             String
  stage              String
  difficulty         Int
  teacher            String
  videoUrl           String
  notes              String
  topics             Json
  completion         Float
  startedAt          DateTime?
  completedAt        DateTime?
  explanationMinutes Int
  practiceMinutes    Int
  questionsAttempted Int
  questionsCorrect   Int
  testScore          Float?
  testTotal          Float?
  order              Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  studySessions  StudySession[]
  scheduleBlocks ScheduleBlock[]
  backlogItems   BacklogItem[]
  tasks          Task[]
  revisions      Revision[]
  mistakes       Mistake[]
  questionSets   QuestionSet[]

  @@index([userId, chapterId])
  @@index([userId, subjectId])
}

model StudySession {
  id                 String    @id
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo             Boolean   @default(false)
  subjectId          String?
  subject            Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId           String?
  lesson             Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  blockId            String?
  activity           String
  title              String
  status             String
  startedAt          DateTime
  endedAt            DateTime?
  plannedMinutes     Int
  actualMinutes      Int
  focusedMinutes     Int
  interruptions      Int
  phoneChecks        Int
  pomodoros          Int
  questionsAttempted Int
  questionsCorrect   Int
  focusRating        Int?
  difficultyRating   Int?
  confidence         Int?
  notes              String
  starter            Boolean
  starterContinued   Boolean?
  startDelayMinutes  Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([userId, startedAt])
}

model ScheduleBlock {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo          Boolean   @default(false)
  date            String
  start           String
  durationMinutes Int
  kind            String
  title           String
  subjectId       String?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  activity        String?
  priority        String?
  status          String
  source          String
  sessionId       String?
  backlogId       String?
  locked          Boolean
  notes           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId, date])
}

model BacklogItem {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo           Boolean   @default(false)
  subjectId        String?
  subject          Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId         String?
  lesson           Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title            String
  activity         String?
  estimatedMinutes Int
  importance       Int
  deadline         String?
  sourceBlockId    String?
  status           String
  scheduledBlockId String?
  notes            String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([userId, status])
}

model Task {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo           Boolean   @default(false)
  title            String
  description      String
  subjectId        String?
  subject          Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId         String?
  lesson           Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  priority         String
  estimatedMinutes Int?
  dueDate          String?
  recurrence       String
  status           String
  tags             Json
  subtasks         Json
  notes            String
  completedAt      DateTime?
  order            Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([userId, status])
}

model Revision {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo          Boolean   @default(false)
  subjectId       String?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  mistakeId       String?
  mistake         Mistake?  @relation(fields: [mistakeId], references: [id], onDelete: SetNull)
  title           String
  type            String
  scheduledDate   String
  durationMinutes Int
  status          String
  rating          Int?
  step            Int
  completedAt     DateTime?
  notes           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId, scheduledDate])
}

model Mistake {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo         Boolean   @default(false)
  subjectId      String?
  subject        Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId       String?
  lesson         Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  question       String
  source         String
  type           String
  explanation    String
  correctMethod  String
  severity       String
  tags           Json
  image          String?
  occurredOn     String
  nextReviewDate String?
  step           Int
  reviewHistory  Json
  resolved       Boolean
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  revisions Revision[]

  @@index([userId, nextReviewDate])
}

model QuestionSet {
  id           String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo       Boolean   @default(false)
  title        String
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  lessonId     String?
  lesson       Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  sessionId    String?
  source       String
  total        Int
  attempted    Int
  correct      Int
  wrong        Int
  skipped      Int
  totalMinutes Float?
  date         String
  notes        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([userId, date])
}

model Exam {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo          Boolean   @default(false)
  name            String
  subjectId       String?
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  date            String
  durationMinutes Int
  totalMarks      Float
  achievedMarks   Float?
  questionCount   Int
  source          String
  notes           String
  mode            String
  status          String
  allowPause      Boolean
  answers         Json
  startedAt       DateTime?
  submittedAt     DateTime?
  timeUsedSec     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId, date])
}

model Goal {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo     Boolean   @default(false)
  name       String
  type       String
  target     Float
  current    Float
  unit       String
  deadline   String?
  subjectId  String?
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  notes      String
  milestones Json
  tracking   String
  trackFrom  String?
  status     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([userId])
}

model CalendarEvent {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo          Boolean   @default(false)
  title           String
  kind            String
  date            String
  start           String
  durationMinutes Int
  recurrence      String
  weekdays        Json
  until           String?
  isFixed         Boolean
  notes           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId, date])
}

model PomodoroSession {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo         Boolean   @default(false)
  sessionId      String?
  subjectId      String?
  phase          String
  startedAt      DateTime
  endedAt        DateTime
  plannedSeconds Int
  actualSeconds  Int
  completed      Boolean
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId, startedAt])
}

model Thought {
  id           String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo       Boolean   @default(false)
  text         String
  status       String
  snoozedUntil String?
  sessionId    String?
  taskId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([userId, status])
}

model SleepEntry {
  id              String    @id
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo          Boolean   @default(false)
  date            String
  bedtime         DateTime
  wakeTime        DateTime
  durationMinutes Int
  quality         Int?
  notes           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId, date])
}

model DailyReview {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo     Boolean   @default(false)
  date       String
  wentWell   String
  change     String
  unfinished String
  summary    Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([userId, date])
}

model WeeklyReview {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo         Boolean   @default(false)
  weekStart      String
  wentWell       String
  obstacle       String
  change         String
  focusSubjectId String?
  summary        Json
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([userId, weekStart])
}

model RoadmapPhase {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDemo           Boolean   @default(false)
  name             String
  description      String
  startDate        String
  endDate          String
  color            String
  order            Int
  targetCompletion Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([userId])
}
